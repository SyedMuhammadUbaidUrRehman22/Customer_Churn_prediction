# Process environment template; the application does not auto-load this file.
DATABASE_URI=mysql+mysqlconnector://USER:URL_ENCODED_PASSWORD@localhost:3306/churn_db
APP_ENV=development

# Production requires genuine dated data, temporal evaluation and business approval.
# telco_snapshot_v1 is permanently rejected by production deployment.
PRODUCTION_FEATURE_SET_VERSION=
PRODUCTION_MODEL_ID=
PRODUCTION_LOW_THRESHOLD=
PRODUCTION_HIGH_THRESHOLD=
PRODUCTION_OUTPUT_TABLE=model_predictions
PRODUCTION_PUBLICATION=atomic_replace
PRODUCTION_FEATURE_REFRESH=external
DEPLOY_ALERT_MODE=logging
DEPLOY_SCHEDULE_ENABLED=false
DEPLOY_SCHEDULE_CRON=
